situation_panel = {
	blockoverride "situation_top_subheader_content" {
		hbox = {
			layoutpolicy_horizontal = expanding
			margin = { 8 5 }
			spacing = 8
			using = bg_cabinet_card_frame
			icon = { size = { 28 28 } texture = "[SituationView.GetActiveSituation.GetIcon]" }
			vbox = {
				minimumsize = { 105 -1 }
				text_single = { text = "KC_ROS_SETTLEMENT_PROGRESS" default_format = "#subtle_name" }
				text_single = { text = "[SituationView.GetActiveSituation.GetSituation.MakeScope.GetVariable('kc_ros_progress').GetValue|2]" default_format = "#yellow_titles" }
			}
			progressbar = {
				layoutpolicy_horizontal = expanding size = { -1 12 }
				using = morale_progressbar_bar min = 0 max = 100
				value = "[FixedPointToFloat(SituationView.GetActiveSituation.GetSituation.MakeScope.GetVariable('kc_ros_progress').GetValue)]"
			}
			vbox = {
				minimumsize = { 95 -1 }
				text_single = { align = right|nobaseline text = "KC_ROS_MONTHLY_PROGRESS" default_format = "#subtle_name" }
				text_single = { align = right|nobaseline text = "[SituationView.GetActiveSituation.GetSituation.MakeScope.GetVariable('kc_ros_monthly_progress').GetValue|+=2]" }
			}
		}
	}

	blockoverride "situation_subheader_content" {}

	blockoverride "situation_panel_main_content" {
		situation_card_expandable = {
			blockoverride "header_button_onclick" { onclick = "[LateralView.Vars.Toggle( 'kc_ros_overview_toggled' )]" }
			blockoverride "header_text" { text = "KC_ROS_COUNCIL_OVERVIEW" }
			blockoverride "header_icon" { texture = "gfx/interface/icons/flat_icons/merchant.dds" }
			blockoverride "visible_hint" {}
			blockoverride "bottom_content" {
				vbox = {
					layoutpolicy_horizontal = expanding spacing = 4
					text_multi = { layoutpolicy_horizontal = expanding maximumsize = { 470 -1 } autoresize = yes text = "KC_ROS_PANEL_OVERVIEW" }
					hbox = {
						layoutpolicy_horizontal = expanding spacing = 12
						vbox = { layoutpolicy_horizontal = expanding text_single = { text = "KC_ROS_HOUSE_INFLUENCE" default_format = "#subtle_name" } text_single = { text = "[SituationView.GetActiveSituation.GetSituation.MakeScope.GetVariable('kc_ros_house_influence').GetValue|0]" default_format = "#yellow_titles" } }
						vbox = { layoutpolicy_horizontal = expanding text_single = { text = "KC_ROS_REGISTERED_INFLUENCE" default_format = "#subtle_name" } text_single = { text = "[SituationView.GetActiveSituation.GetSituation.MakeScope.GetVariable('kc_ros_registered_influence').GetValue|0]" default_format = "#yellow_titles" } }
						vbox = { layoutpolicy_horizontal = expanding text_single = { text = "KC_ROS_NATIONAL_INFLUENCE" default_format = "#subtle_name" } text_single = { text = "[SituationView.GetActiveSituation.GetSituation.MakeScope.GetVariable('kc_ros_national_influence').GetValue|0]" default_format = "#yellow_titles" } }
					}
				}
			}
			blockoverride "bottom_content_onclick" { visible = "[LateralView.Vars.Exists( 'kc_ros_overview_toggled' )]" }
			blockoverride "icon_replace_visible_yes" { visible = "[LateralView.Vars.Exists( 'kc_ros_overview_toggled' )]" }
			blockoverride "icon_replace_visible_not" { visible = "[Not(LateralView.Vars.Exists( 'kc_ros_overview_toggled' ))]" }
		}

		situation_card_one_line = {
			blockoverride "header_icon" { texture = "[SituationView.GetActiveSituation.GetIcon]" }
			blockoverride "header_text" { text = "KC_ROS_WARRANTS_ARTICLE" }
			blockoverride "header_content_rest" { text_single = { visible = "[SituationView.GetActiveSituation.GetSituation.MakeScope.GetVariable('kc_ros_warrants_ratified').IsSet]" text = "KC_ROS_RATIFIED" default_format = "#color_green" } text_single = { visible = "[Not(SituationView.GetActiveSituation.GetSituation.MakeScope.GetVariable('kc_ros_warrants_ratified').IsSet)]" text = "KC_ROS_PENDING" default_format = "#subtle_name" } }
		}
		situation_card_one_line = {
			blockoverride "header_icon" { texture = "[SituationView.GetActiveSituation.GetIcon]" }
			blockoverride "header_text" { text = "KC_ROS_RESIDENCE_ARTICLE" }
			blockoverride "header_content_rest" { text_single = { visible = "[SituationView.GetActiveSituation.GetSituation.MakeScope.GetVariable('kc_ros_residence_ratified').IsSet]" text = "KC_ROS_RATIFIED" default_format = "#color_green" } text_single = { visible = "[Not(SituationView.GetActiveSituation.GetSituation.MakeScope.GetVariable('kc_ros_residence_ratified').IsSet)]" text = "KC_ROS_PENDING" default_format = "#subtle_name" } }
		}
		situation_card_one_line = {
			blockoverride "header_icon" { texture = "[SituationView.GetActiveSituation.GetIcon]" }
			blockoverride "header_text" { text = "KC_ROS_FAITH_LAW_ARTICLE" }
			blockoverride "header_content_rest" { text_single = { visible = "[SituationView.GetActiveSituation.GetSituation.MakeScope.GetVariable('kc_ros_faith_law_ratified').IsSet]" text = "KC_ROS_RATIFIED" default_format = "#color_green" } text_single = { visible = "[Not(SituationView.GetActiveSituation.GetSituation.MakeScope.GetVariable('kc_ros_faith_law_ratified').IsSet)]" text = "KC_ROS_PENDING" default_format = "#subtle_name" } }
		}
		situation_card_one_line = {
			blockoverride "header_icon" { texture = "[SituationView.GetActiveSituation.GetIcon]" }
			blockoverride "header_text" { text = "KC_ROS_COMMUNITIES_ARTICLE" }
			blockoverride "header_content_rest" { text_single = { visible = "[SituationView.GetActiveSituation.GetSituation.MakeScope.GetVariable('kc_ros_communities_ratified').IsSet]" text = "KC_ROS_RATIFIED" default_format = "#color_green" } text_single = { visible = "[Not(SituationView.GetActiveSituation.GetSituation.MakeScope.GetVariable('kc_ros_communities_ratified').IsSet)]" text = "KC_ROS_PENDING" default_format = "#subtle_name" } }
		}
		situation_card_one_line = {
			blockoverride "header_icon" { texture = "[SituationView.GetActiveSituation.GetIcon]" }
			blockoverride "header_text" { text = "KC_ROS_FLEETS_ARTICLE" }
			blockoverride "header_content_rest" { text_single = { visible = "[SituationView.GetActiveSituation.GetSituation.MakeScope.GetVariable('kc_ros_fleets_ratified').IsSet]" text = "KC_ROS_RATIFIED" default_format = "#color_green" } text_single = { visible = "[Not(SituationView.GetActiveSituation.GetSituation.MakeScope.GetVariable('kc_ros_fleets_ratified').IsSet)]" text = "KC_ROS_PENDING" default_format = "#subtle_name" } }
		}
		situation_card_one_line = {
			blockoverride "header_icon" { texture = "[SituationView.GetActiveSituation.GetIcon]" }
			blockoverride "header_text" { text = "KC_ROS_CUSTOMS_ARTICLE" }
			blockoverride "header_content_rest" { text_single = { visible = "[SituationView.GetActiveSituation.GetSituation.MakeScope.GetVariable('kc_ros_customs_ratified').IsSet]" text = "KC_ROS_RATIFIED" default_format = "#color_green" } text_single = { visible = "[Not(SituationView.GetActiveSituation.GetSituation.MakeScope.GetVariable('kc_ros_customs_ratified').IsSet)]" text = "KC_ROS_PENDING" default_format = "#subtle_name" } }
		}

		situation_card_expandable = {
			blockoverride "header_button_onclick" { onclick = "[LateralView.Vars.Toggle( 'kc_ros_requirements_toggled' )]" }
			blockoverride "header_text" { text = "END_REQUIREMENTS" }
			blockoverride "header_icon" { texture = "gfx/interface/icons/disasters/end_requirements_green.dds" }
			blockoverride "visible_hint" {}
			blockoverride "bottom_content" { TooltipRequirementsList = { textcontext = "[SituationView.GetActiveSituation.GetSituation.GetEndConditions]" } }
			blockoverride "bottom_content_onclick" { visible = "[LateralView.Vars.Exists( 'kc_ros_requirements_toggled' )]" }
			blockoverride "icon_replace_visible_yes" { visible = "[LateralView.Vars.Exists( 'kc_ros_requirements_toggled' )]" }
			blockoverride "icon_replace_visible_not" { visible = "[Not(LateralView.Vars.Exists( 'kc_ros_requirements_toggled' ))]" }
		}
	}
}
